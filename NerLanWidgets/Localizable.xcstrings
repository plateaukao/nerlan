    "NerLan": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "下一集": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Episode"
          }
        }
      }
    },
    "今天聽了多久、連續學習幾天。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long you listened today, and your streak."
          }
        }
      }
    },
    "今日 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %@"
          }
        }
      }
    },
    "今日學習": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "先收藏一個節目\n再選它顯示最新單集": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite a show first\nthen pick it here"
          }
        }
      }
    },
    "分鐘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        }
      }
    },
    "剩 %lld 分鐘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min left"
          }
        }
      }
    },
    "剩 %lld 秒": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llds left"
          }
        }
      }
    },
    "單集編號": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episode ID"
          }
        }
      }
    },
    "在目前的單集內前後跳 15 秒。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump 15 seconds forward or back within the current episode."
          }
        }
      }
    },
    "學習紀錄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening Stats"
          }
        }
      }
    },
    "尚未取得最新單集": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No latest episode yet"
          }
        }
      }
    },
    "從上次停下的地方繼續播放整個節目。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume the whole show from where you left off."
          }
        }
      }
    },
    "從上次停下的地方繼續，整個節目接著播。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume where you left off and keep the show rolling."
          }
        }
      }
    },
    "快轉或倒轉": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip Forward or Back"
          }
        }
      }
    },
    "我的節目": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Shows"
          }
        }
      }
    },
    "挑選要顯示的節目；不選的話依收聽時間排序。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick which shows to display; otherwise they’re ordered by listening time."
          }
        }
      }
    },
    "接下來": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up Next"
          }
        }
      }
    },
    "播放單集": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Episode"
          }
        }
      }
    },
    "播放或暫停": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play or Pause"
          }
        }
      }
    },
    "播放或暫停目前的單集。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play or pause the current episode."
          }
        }
      }
    },
    "播放指定的單集。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a specific episode."
          }
        }
      }
    },
    "播放過的節目\n會出現在這裡": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows you play\nappear here"
          }
        }
      }
    },
    "收藏的節目與訂閱的 Podcast，一按就打開。可自選要顯示哪幾個。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorited shows and podcast subscriptions, one tap away. Choose which ones to show."
          }
        }
      }
    },
    "是否為 Podcast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is Podcast"
