<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac Catalyst entitlements for the widget extension. Same App Group as the
  generated iOS NerLanWidgets.entitlements, but team-prefixed: macOS requires
  "TEAMID.group.…" where iOS uses the bare "group.…" form. Wired via
  CODE_SIGN_ENTITLEMENTS[sdk=macosx*] in project.yml.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TeamIdentifierPrefix)group.com.danielkao.NerLan</string>
    </array>
</dict>
</plist>
